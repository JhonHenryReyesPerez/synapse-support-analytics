        1100,
        320
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Validar Token y Datos').first().json;\nconst ok = $input.first().json.status === 'ok';\nreturn [{ json: { response: ok\n  ? { ...data.base, status: 'REMOVED', errorCode: null }\n  : { ...data.base, status: 'ERROR', errorCode: 'VECTOR_DELETE_FAILED' } } }];"
      },
      "id": "Resultado DELETE",
      "name": "Resultado DELETE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.OPENROUTER_BASE_URL || 'https://openrouter.ai/api/v1') + '/embeddings' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.OPENROUTER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
