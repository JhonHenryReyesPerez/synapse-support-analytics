        "options": {
          "timeout": 10000
        }
      },
      "id": "Upsert Point en Qdrant",
      "name": "Upsert Point en Qdrant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        640
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Validar Token y Datos').first().json;\nconst point = $('Preparar Punto').first().json;\nconst ok = $input.first().json.status === 'ok';\nreturn [{ json: { response: ok\n  ? { ...data.base, status: 'INDEXED', embeddingModel: data.embeddingModel,\n      embeddingDimension: point.dimension, chunkCount: 1, errorCode: null }\n  : { ...data.base, status: 'ERROR', errorCode: 'VECTOR_UPSERT_FAILED' } } }];"
      },
      "id": "Resultado UPSERT",
