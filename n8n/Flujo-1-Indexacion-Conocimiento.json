      },
      "id": "Generar Embedding OpenRouter",
      "name": "Generar Embedding OpenRouter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        540
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Validar Token y Datos').first().json;\nconst vector = $input.first().json?.data?.[0]?.embedding;\nif (!Array.isArray(vector) || vector.length === 0) {\n  return [{ json: { route: 'respond', response: { ...data.base, status: 'ERROR', errorCode: 'EMBEDDING_FAILED' } } }];\n}\n// Identidad determinista: el id del punto es el del artículo, así que reindexar reemplaza y no duplica.\nreturn [{ json: {\n  route: 'upsert',\n  dimension: vector.length,\n  upsertBody: { points: [{\n    id: data.base.articleId,\n    vector,\n    payload: {\n      articleId: data.base.articleId,\n      contentVersion: data.base.contentVersion,\n      contentHash: data.contentHash,\n      chunkIndex: 0,\n      title: data.title,\n      embeddingModel: data.embeddingModel,\n    },\n  }] },\n} }];"
      },
