      "id": "Webhook Indexacion",
      "name": "Webhook Indexacion",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "campusdesk-index"
    },
    {
      "parameters": {
        "jsCode": "// Contrato v1 (docs/backend/CONTRATO_N8N.md §2). El secreto solo llega por variable de entorno.\nconst expected = $env.N8N_SERVICE_TOKEN;\nconst input = $input.first().json;\nconst token = (input.headers || {})['x-service-token'];\nif (!expected || !token || token !== expected) {\n  return [{ json: { route: 'unauthorized' } }];\n}\n\nconst body = input.body || {};\nconst base = {\n  schemaVersion: 1,\n  articleId: body.articleId ?? null,\n  contentVersion: body.contentVersion ?? null,\n};\nconst fail = (errorCode) => [{ json: { route: 'respond', response: { ...base, status: 'ERROR', errorCode } } }];\n\nconst idsOk = Number.isInteger(body.articleId) && body.articleId > 0\n  && Number.isInteger(body.contentVersion) && body.contentVersion >= 1;\nif (body.schemaVersion !== 1 || !idsOk || !['UPSERT', 'DELETE'].includes(body.action)) {\n  return fail('INVALID_REQUEST');\n}\n\nif (body.action === 'DELETE') {\n  return [{ json: {\n    route: 'delete',\n    base,\n    deleteBody: { filter: { must: [{ key: 'articleId', match: { value: body.articleId } }] } },\n  } }];\n}\n\nconst text = (value) => (typeof value === 'string' ? value.trim() : '');\nif (!text(body.title) || !text(body.solution)) {\n  return fail('INVALID_REQUEST');\n}\n// Un punto por artículo: el texto completo se vectoriza como un único fragmento (índice 0).\nconst sections = [\n  ['Título', body.title], ['Problema', body.problem], ['Síntomas', body.symptoms],\n  ['Causa', body.cause], ['Solución', body.solution],\n].filter(([, value]) => text(value)).map(([label, value]) => `${label}: ${text(value)}`);\nconst embeddingModel = $env.EMBEDDING_MODEL || 'openai/text-embedding-3-small';\n\nreturn [{ json: {\n  route: 'upsert',\n  base,\n  title: text(body.title),\n  contentHash: body.contentHash ?? null,\n  embeddingModel,\n  embeddingBody: { model: embeddingModel, input: sections.join('\\n\\n') },\n} }];"
      },
      "id": "Validar Token y Datos",
      "name": "Validar Token y Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.route }}",
