    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.QDRANT_URL || 'http://qdrant:6333') + '/collections/' + ($env.QDRANT_COLLECTION || 'articulos_soporte') + '/points/delete?wait=true' }}",
        "sendHeaders": true,
