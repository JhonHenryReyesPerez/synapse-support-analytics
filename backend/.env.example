# Copia este archivo como backend/.env y reemplaza los valores.
# .env está excluido de Git: nunca subas valores reales.

# Perfil: exportarlo en la terminal (SPRING_PROFILES_ACTIVE=dev); aquí no se aplica.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/campusDESK
DB_USERNAME=cambia_este_usuario
DB_PASSWORD=cambia_esta_clave

# JWT: mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_32_o_mas_caracteres
JWT_ISSUER=campusdesk-api
JWT_EXPIRATION=30m

# Control de intentos de login: tras LOGIN_MAX_ATTEMPTS fallos dentro de LOGIN_ATTEMPT_WINDOW,
# el identificador queda bloqueado durante LOGIN_LOCK_DURATION (estado en memoria)
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15m
LOGIN_LOCK_DURATION=15m

# Administrador inicial (solo se crea si no existe)
BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@campusdesk.local
ADMIN_PASSWORD=cambia_esta_clave_Segura1!

SERVER_PORT=8051

# n8n: URL fija del orquestador y secretos de servicio (mínimo 32 caracteres, openssl rand -hex 32)
# N8N_SERVICE_TOKEN: lo envía Spring Boot a los webhooks de n8n (cabecera X-Service-Token)
# INTEGRATION_API_TOKEN: lo envía n8n a /api/integration/** (cabecera X-Integration-Token)
N8N_BASE_URL=http://localhost:5678
N8N_SERVICE_TOKEN=reemplazar_por_un_secreto_aleatorio_de_32_o_mas_caracteres
INTEGRATION_API_TOKEN=reemplazar_por_otro_secreto_aleatorio_de_32_o_mas_caracteres
N8N_CONNECT_TIMEOUT=5s
N8N_READ_TIMEOUT=60s

# Asistente RAG: artículos a recuperar (3 a 5), umbral mínimo de similitud coseno (0 a 1) y edad
# a partir de la cual una consulta sin resultado se cierra como error (mayor que dos intentos de n8n)
ASSIST_MAX_RESULTS=5
ASSIST_MIN_SCORE=0.55
ASSIST_PENDING_TIMEOUT=5m

# Orígenes del frontend permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Zona horaria de negocio para fechas y agrupaciones (por defecto America/Bogota)
# APP_TIME_ZONE=America/Bogota
