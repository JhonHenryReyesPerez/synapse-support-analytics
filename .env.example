# ==========================================
# Synapse Support Analytics (CampusDesk)
# Variables de Entorno de Configuración
# ==========================================

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incidentes_db
DB_USER=postgres
DB_PASSWORD=postgres123

# Base de datos vectorial Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Motor de flujos n8n
N8N_PORT=5679

# Backend Spring Boot
BACKEND_PORT=8080

# Proveedor de Inteligencia Artificial (OpenRouter)
# Reemplaza con tu clave de API de OpenRouter
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui

# Seguridad JWT (Mínimo 32 caracteres)
JWT_SECRET=campusdesk-super-secret-jwt-key-minimum-32-chars-2026
JWT_EXPIRATION_MINUTES=30

# Tokens de Integración entre Spring Boot y n8n (Mínimo 32 caracteres)
N8N_SERVICE_TOKEN=campusdesk-super-secret-service-token-2026
INTEGRATION_API_TOKEN=campusdesk-super-secret-integration-token-2026
