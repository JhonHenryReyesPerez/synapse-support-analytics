# Variables del entorno completo (docker-compose.yml).
# Copiar a .env y reemplazar cada marcador. El archivo .env no se versiona.
# Los secretos no tienen valor por defecto: si falta uno, Compose se niega a arrancar.

# --- PostgreSQL ---
DB_NAME=campusdesk
DB_USERNAME=campusdesk
DB_PASSWORD=reemplazar_por_una_clave
DB_PORT=5432

# --- Backend ---
SERVER_PORT=8051
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_32_o_mas_caracteres
JWT_EXPIRATION=30m
# Orígenes del frontend permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Administrador inicial (solo se crea si no existe)
BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@campusdesk.local
ADMIN_PASSWORD=reemplazar_por_una_clave_Segura1!

# --- Integración Spring Boot <-> n8n: dos secretos distintos, mínimo 32 caracteres ---
# El backend lo envía a los webhooks de n8n (cabecera X-Service-Token)
N8N_SERVICE_TOKEN=reemplazar_por_un_secreto_aleatorio_de_32_o_mas_caracteres
# n8n lo envía a /api/integration/** (cabecera X-Integration-Token)
INTEGRATION_API_TOKEN=reemplazar_por_otro_secreto_aleatorio_de_32_o_mas_caracteres

# --- Asistente RAG ---
# Artículos a recuperar (3 a 5) y umbral mínimo de similitud coseno (0 a 1)
ASSIST_MAX_RESULTS=5
ASSIST_MIN_SCORE=0.55

# --- n8n, Qdrant y proveedor de modelos ---
N8N_PORT=5678
QDRANT_PORT=6333
QDRANT_COLLECTION=articulos_soporte
OPENROUTER_API_KEY=reemplazar_por_la_clave_de_openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# El modelo de embeddings debe producir vectores de la dimensión de qdrant/collection_config.json (1536)
# y ser el mismo para indexar y para consultar.
EMBEDDING_MODEL=openai/text-embedding-3-small
GENERATION_MODEL=google/gemini-2.5-flash
# Máximo de tokens de la respuesta generada. Sin límite, el proveedor reserva el máximo del modelo
# y rechaza la petición si el saldo no lo cubre.
GENERATION_MAX_TOKENS=1500
